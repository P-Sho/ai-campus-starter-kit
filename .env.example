# Copy to your shell environment (main.py reads these via os.getenv; no .env loader is used).
# If unset, a random per-process value is generated at startup.

# Password for POST /admin/login
TODO_ADMIN_PASSWORD=
# Token required in the x-auth-token header for POST /api/items
ADMIN_MASTER_TOKEN=
# SQLite database path (default: service.db)
DB_FILE=service.db
